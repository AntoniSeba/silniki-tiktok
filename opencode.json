{
  "$schema": "https://opencode.ai/config.json",
  "model": "byteplus/dola-seed-2.0-code",
  "small_model": "byteplus/dola-seed-2.0-lite",
  "provider": {
    "byteplus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BytePlus ModelArk (Coding Plan)",
      "options": {
        "baseURL": "https://ark.ap-southeast.bytepluses.com/api/coding/v3",
        "apiKey": "{env:BYTEPLUS_API_KEY}"
      },
      "models": {
        "ark-code-latest": { "name": "ModelArk Auto", "limit": { "context": 128000, "output": 8192 } },
        "dola-seed-2.0-code": { "name": "Seed 2.0 Code", "limit": { "context": 262144, "output": 131072 } },
        "dola-seed-2.0-pro": { "name": "Seed 2.0 Pro", "limit": { "context": 262144, "output": 131072 } },
        "dola-seed-2.0-lite": { "name": "Seed 2.0 Lite", "limit": { "context": 262144, "output": 131072 } },
        "bytedance-seed-code": { "name": "ByteDance Seed Code", "limit": { "context": 128000, "output": 8192 } },
        "glm-5.1": { "name": "GLM 5.1", "limit": { "context": 204800, "output": 65536 } },
        "glm-4.7": { "name": "GLM 4.7", "limit": { "context": 204800, "output": 65536 } },
        "kimi-k2.5": { "name": "Kimi K2.5", "limit": { "context": 262144, "output": 65536 } },
        "deepseek-v3.2": { "name": "DeepSeek V3.2", "limit": { "context": 131072, "output": 8192 } },
        "gpt-oss-120b": { "name": "GPT-OSS 120B", "limit": { "context": 128000, "output": 8192 } }
      }
    }
  }
}
